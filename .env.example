# ==============================================================================
# StyleMirror Environment Variables Template
# Copy this file to .env at project root and fill in your values.
# NEVER commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# HOST PORT & DOMAIN BINDINGS (Used by Docker Compose)
# ------------------------------------------------------------------------------
# Public port mapping on host machine (default: 80)
# [Used by: docker-compose.yml] [Secret: NO]
PORT=80

# Domain for optional HTTPS profile (Caddy auto-SSL)
# [Used by: caddy service in docker-compose.yml] [Secret: NO]
DOMAIN=localhost


# ------------------------------------------------------------------------------
# FRONTEND BUILD ARGS (Injected during web container build)
# ------------------------------------------------------------------------------
# Hosted Supabase project URL for catalog queries
# [Used by: web builder & frontend client] [Secret: NO]
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Hosted Supabase Anonymous public API Key (Read-only catalog RLS)
# [Used by: web builder & frontend client] [Secret: NO]
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token


# ------------------------------------------------------------------------------
# BACKEND RUNTIME VARIABLES (Mounted into API container)
# ------------------------------------------------------------------------------
# Hosted Supabase project URL
# [Used by: api service] [Secret: NO]
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (DO NOT EXPOSE TO WEB)
# [Used by: api service for session management & RLS bypass] [Secret: YES]
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret

# Supabase Anonymous Key (optional fallback in backend)
# [Used by: api service] [Secret: NO]
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token

# CORS Allowed Origins
# [Used by: api service FastAPI middleware] [Secret: NO]
CORS_ORIGINS=http://localhost,http://localhost:5173

# Logging Level (debug, info, warning, error)
# [Used by: api service] [Secret: NO]
LOG_LEVEL=info

# Optional LLM Stylist Key (Part 10 Upgrade C)
# [Used by: api service] [Secret: YES]
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
