# ==============================================================================
# StyleMirror Environment Variables Template
# Copy this file to .env in apps/web/ and apps/api/ with your project values.
# NEVER commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (apps/web/.env)
# ------------------------------------------------------------------------------
# Public Supabase URL for public catalog queries
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous API Key (used ONLY for public catalog read queries)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token

# Base URL for backend API proxy / direct calls
VITE_API_BASE_URL=http://localhost:8000


# ------------------------------------------------------------------------------
# BACKEND (apps/api/.env)
# ------------------------------------------------------------------------------
# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (CRITICAL: used ONLY in backend, NEVER frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret

# Supabase Anonymous Key (optional fallback in backend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Logging Level (debug, info, warning, error)
LOG_LEVEL=info
