        "title": "GarmentDetailResponse"
      },
      "GarmentSizeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "size_label": {
            "type": "string",
            "title": "Size Label"
          },
          "glb_url": {
            "type": "string",
            "title": "Glb Url"
          },
          "chest_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chest Cm"
          },
